{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulk-import-multiplayer",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*", "/healthz", "/multiplayer", "/play"]
  },
  "durable_objects": {
    "bindings": [{"name":"GAME_ROOMS","class_name":"GameRooms"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["GameRooms"]}]
}
